{
  "manifest_version": 3,
  "name": "MTC → Licencias",
    "version": "1.1.0",
  "description": "Guarda en el sistema un resultado consultado manualmente en el portal del MTC.",
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
            "matches": [
                "https://licencias.mtc.gob.pe/*",
                "https://soat-licencia.stkkft.easypanel.host/*"
            ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
    "action": {
    "default_title": "Guardar consulta MTC",
    "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
  "host_permissions": [
    "https://soat-licencia.stkkft.easypanel.host/*"
  ]
}
